# E-Pedia Environment Configuration
# Copy this file to .env and replace with your actual Firebase & Gemini credentials

# Firebase Configuration (Get these from https://console.firebase.google.com/)
VITE_FIREBASE_API_KEY=YOUR_API_KEY
VITE_FIREBASE_AUTH_DOMAIN=epedia-app.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=epedia-app
VITE_FIREBASE_STORAGE_BUCKET=epedia-app.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef123456

# Optional: Google Gemini API Key for Live AI Quizzes (Get from https://aistudio.google.com/)
VITE_GEMINI_API_KEY=YOUR_GEMINI_API_KEY
